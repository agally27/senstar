# Senstar environment variables — documentation only. NEVER put real secrets in this file.
# Local development: copy to .env.local (gitignored) and fill in values.
# CI: GitHub Actions encrypted secrets. Deployed: Vercel encrypted env vars (per environment).
# See docs/adr/0008-config-and-secrets.md.

# --- server (non-secret) ---
# Which environment this process believes it is in: development | test | preview | production
APP_ENV=development

# --- secret (server-only) ---
# Postgres connection for the APPLICATION (ADR-0009): the non-owning `senstar_app`
# role. It cannot create tables and cannot bypass row-level security. This is the
# only database URL the web app should ever hold.
# Preview/production: Neon (aws-eu-west-2) per-environment branches — NEVER the production URL locally.
DATABASE_URL=postgresql://senstar_app:password@host:5432/dbname

# Postgres connection for MIGRATIONS ONLY (ADR-0009): the owner role. Used by
# `pnpm db:migrate` and CI. Must NOT be present in the web app's runtime
# environment in preview or production — the app runs with DATABASE_URL alone.
#
# On Neon, create `senstar_app` with SQL (the migration does this). A role created
# through the Neon Console/CLI/API is granted neon_superuser, which carries
# BYPASSRLS and silently defeats row-level security.
MIGRATION_DATABASE_URL=postgresql://owner:password@host:5432/dbname

# Better Auth secret (generate: openssl rand -base64 32) — per environment, never shared between them.
BETTER_AUTH_SECRET=replace-me

# Base URL the auth layer uses for callbacks/verification links.
BETTER_AUTH_URL=http://localhost:3000

# --- public (safe for browser, must be prefixed NEXT_PUBLIC_) ---
NEXT_PUBLIC_APP_ENV=development
